{
  "name": "tesla-roadster-landing",
  "version": "1.0.0",
  "description": "Tesla Roadster Landing: reinforcement learning (Gymnasium + PPO) teaches a jet-pack Roadster to jump parked cars and land on a spot, with GIFs and a live animation of every attempt.",
  "bin": {
    "roadster-landing": "cli.js"
  },
  "scripts": {
    "setup": "node cli.js setup",
    "demo": "node cli.js demo",
    "test": "node cli.js test",
    "train": "node cli.js train",
    "watch": "node cli.js watch",
    "flip": "node cli.js flip",
    "view": "node cli.js view",
    "replay": "node cli.js replay",
    "video": "node cli.js video",
    "scripted": "node cli.js scripted",
    "help": "node cli.js help"
  },
  "files": [
    "cli.js",
    "*.py",
    "requirements.txt",
    "models/pretrained_t67.zip",
    "README.md"
  ],
  "keywords": [
    "tesla-roadster",
    "reinforcement-learning",
    "gymnasium",
    "stable-baselines3",
    "ppo",
    "simulation",
    "gif"
